# Math Wizard Quest — adapted from GitHub's gitignore templates:
# https://github.com/github/gitignore/blob/main/Node.gitignore
# https://github.com/github/gitignore/blob/main/Global/macOS.gitignore
# https://github.com/github/gitignore/blob/main/Global/VisualStudioCode.gitignore

# Local project documents and original resources — never publish from this workspace
/SDLC/
/outputs/
/core concept/
/planing step/
/doing step/
/reports/
/research_notes/
/resource/

# Dependencies, generated output and caches
node_modules/
dist/
build/
out/
coverage/
.nyc_output/
.cache/
.parcel-cache/
.vite/
.npm/
.pnpm-store/
*.tsbuildinfo
.pnp.*
.yarn/*
!.yarn/patches/
!.yarn/plugins/
!.yarn/releases/
!.yarn/sdks/
!.yarn/versions/

# Local environment files; keep configuration examples
.env
.env.*
!.env.example
!.env.sample
!.env.*.example
!.env.*.sample

# Logs and process files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.pid
*.pid.lock

# macOS metadata
.DS_Store
.localized
._*
.AppleDouble
.LSOverride
__MACOSX/
.Spotlight-V100
.TemporaryItems
.Trashes
.apdisk

# Editor local state; keep shared VS Code configuration
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.vscode-test/
*.vsix
*.swp
*.swo
*~

# Generated test artifacts and temporary files
test-results/
playwright-report/
/tmp/
/.temp/

# Publish only the application; keep its runtime assets and package lockfiles.

# Local verification and notes are not part of the public web app.
/tests/
/README.md

# Local SDLC catalog tooling and SQLite transient files
__pycache__/
*.py[cod]
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
